VULCAN_VERSION=0.3.0
VULCAN_COMMIT_SHA=replace-with-release-commit
VULCAN_BUILD_ID=replace-with-release-build-id
VULCAN_PUBLIC_URL=http://192.168.200.7
VULCAN_BIND_ADDRESS=0.0.0.0
VULCAN_HTTP_PORT=80
VULCAN_AUTH_TOKEN_TTL_MINUTES=480

VULCAN_ROOT_EMAIL=root@vulcan.local
ERS_ADMIN_EMAIL=admin.ers@erstransportes.local
ERS_WALLBOARD_EMAIL=wallboard@erstransportes.local

EMAIL_DELIVERY_MODE=mock
EVOLUTION_ENABLED=true
ROOT_WHATSAPP_ENABLED=false
OPENAI_MODEL=gpt-5.5
AI_COMPLEX_MODEL=gpt-5.5
AI_OPERATIONAL_MODEL=llama-4-maverick

DISCOVERY_ENABLED=false
DISCOVERY_WORKER_POLL_SECONDS=10
DISCOVERY_MAX_TARGETS_PER_RUN=256
DISCOVERY_MAX_CONCURRENCY=16
DISCOVERY_MAX_TIMEOUT_MS=2000
DISCOVERY_ALLOWED_TCP_PORTS=22,53,80,443,445,515,631,9100
