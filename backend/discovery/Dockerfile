FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend/discovery

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends iputils-ping \
    && rm -rf /var/lib/apt/lists/*

COPY backend/discovery /app/backend/discovery

RUN pip install --upgrade pip \
    && pip install /app/backend/discovery

USER nobody

CMD ["python", "-m", "app.main"]
