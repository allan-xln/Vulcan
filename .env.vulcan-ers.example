# Copie para .env.vulcan-ers e preencha somente no ambiente local.
# Nunca use a service key em código do navegador.
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LOCAL_TEST_AUTH=false
NEXT_PUBLIC_MOCK_AUTH=false
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false
AUTH_PROVIDER=supabase
MOCK_AUTH=false
MOCK_DATA=false
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_REST_URL=https://<project-ref>.supabase.co/rest/v1
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-key>
DATABASE_URL=postgresql://<pooler-user>:<url-encoded-password>@<pooler-host>:6543/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://<pooler-user>:<url-encoded-password>@<pooler-host>:6543/postgres?sslmode=require
